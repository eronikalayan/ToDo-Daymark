# Copy this file to .env for development. Generate a unique 64+ character secret for production.
NODE_ENV=development
PORT=4000
DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"
JWT_TTL_SECONDS=604800
COOKIE_NAME=daymark_session
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
SERVE_FRONTEND=true
APP_BASE_URL=http://localhost:4000
# Production only: configure your transactional email provider.
# EMAIL_PROVIDER_URL=https://api.mail-provider.example/send
# EMAIL_PROVIDER_TOKEN=secret-from-your-provider
# EMAIL_FROM=noreply@example.com
# Comma-separated exact browser origins. Include your actual frontend origin.
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5500,http://127.0.0.1:5500
